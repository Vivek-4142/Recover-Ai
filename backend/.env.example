# Recover-Ai Backend Environment Variables

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Fallback is local SQLite file if left blank or unset
# For production deployment (e.g. PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///./recover_ai.db

# JWT Security
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=super_secret_jwt_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP Email Configuration
MAIL_USERNAME=placeholder@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD
MAIL_FROM=placeholder@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
